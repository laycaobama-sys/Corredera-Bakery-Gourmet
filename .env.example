# ==============================================================================
# CORREDERA BAKERY & GOURMET (Vallejo Lorenzo S.L.)
# Plantilla de Variables de Entorno para Producción y Desarrollo (.env.example)
# ==============================================================================
# IMPORTANTE:
# - NUNCA subas el archivo .env con valores reales al repositorio Git.
# - Configura los secretos directamente en el gestor de secretos del servidor
#   (Cloud Run Secret Manager, Railway/Render Environment, o /etc/corredera/.env
#   con permisos chmod 600).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EJECUCIÓN DEL SERVIDOR NODE.JS + EXPRESS (OBLIGATORIAS EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Modo de ejecución: "production" activa cookies Secure, HSTS y el servidor
# de archivos estáticos compilados desde dist/public.
NODE_ENV=production

# Puerto de escucha HTTP del proceso Node.js (detrás de Cloudflare / Reverse Proxy)
PORT=3000

# ------------------------------------------------------------------------------
# 2. SEGURIDAD DE SESIONES Y ACCESO AL PANEL PRIVADO /admin (OBLIGATORIA)
# ------------------------------------------------------------------------------
# Secreto criptográfico de al menos 32 caracteres aleatorios para firmar
# los tokens JWT HS256 de las sesiones HttpOnly del panel de administración (/admin).
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Clave maestra opcional de propietario para /admin (mínimo 12 caracteres).
# Si se deja vacía, el propietario puede definir su clave en el primer acceso a
# /admin (se guarda con hash scrypt + sal en server/data/admin-credentials.json)
# y cambiarla en cualquier momento desde /admin -> Datos Legales & Seguridad.
ADMIN_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. DOMINIO CANÓNICO Y ORÍGENES CORS PERMITIDOS (RECOMENDADA AL CONECTAR DOMINIO)
# ------------------------------------------------------------------------------
# Lista separada por comas de dominios adicionales autorizados en CORS cuando
# conectes el nuevo dominio comprado en Cloudflare (además de correderagourmet.com).
# Ejemplo: https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=https://correderagourmet.com,https://www.correderagourmet.com

# ------------------------------------------------------------------------------
# 4. BASE DE DATOS RELACIONAL MYSQL / TIDB (OPCIONAL - MODO HÍBRIDO ACTIVO)
# ------------------------------------------------------------------------------
# La aplicación funciona con persistencia dual:
# - Sin DATABASE_URL: persiste catálogo, ajustes CMS, auditoría y pedidos en
#   archivos JSON atómicos en server/data/ (requiere volumen persistente montado).
# - Con DATABASE_URL: sincroniza automáticamente productos, auditoría y usuarios
#   con MySQL 8+ / TiDB mediante Drizzle ORM, manteniendo copia en server/data/.
# Formato: mysql://usuario:password@host:3306/corredera_prod?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. INTEGRACIÓN OAUTH / SSO DE PLATAFORMA (OPCIONAL)
# ------------------------------------------------------------------------------
# Solo necesarias si se emplea inicio de sesión SSO externo además de la clave
# privada de propietario en /admin.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_OAUTH_PORTAL_URL=

# ------------------------------------------------------------------------------
# 6. PROXY DE ALMACENAMIENTO / SERVICIOS EXTERNOS (OPCIONAL)
# ------------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

