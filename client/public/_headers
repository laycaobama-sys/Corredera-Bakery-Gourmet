# Cloudflare static asset headers — Corredera Bakery & Gourmet
# Pages are served by the Worker (worker/index.ts), which adds the security headers.

# Content-hashed JS, CSS and fonts never change
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and video: one day, then revalidate (the owner can replace them)
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
