// Cloudflare Workers deployment: static site + API + admin panel + data, all on Cloudflare.
// Build: `pnpm build:cloudflare` · Deploy: `pnpm deploy:cloudflare` (or connect the GitHub repo in Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corredera-gourmet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // These have static copies but are generated live from the catalog and CMS.
    "run_worker_first": ["/", "/index.html", "/sitemap.xml", "/llms.txt"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "CorrederaStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CorrederaStore"] }],
  "alias": {
    "drizzle-orm/mysql2": "./worker/stubs/drizzle-mysql2.ts"
  },
  "vars": {
    "NODE_ENV": "production",
    "DATA_DIR": "/data",
    "UPLOAD_DIR": "/uploads"
  },
  "observability": { "enabled": true }
}
